# Copy this file to `.env` to override any default setting.
# All values are optional -- sensible defaults are defined in config.py.

# --- Directories ---
PDF_AGENT_INPUT_DIR=input
PDF_AGENT_OUTPUT_DIR=output
PDF_AGENT_LOGS_DIR=logs

# --- Processing ---
PDF_AGENT_CHUNK_SIZE=25
PDF_AGENT_BATCH_SIZE=500
PDF_AGENT_LARGE_PDF_THRESHOLD=200

# --- Feature toggles ---
PDF_AGENT_EXTRACT_IMAGES=true
PDF_AGENT_ENABLE_OCR=false
PDF_AGENT_OCR_DPI=200
PDF_AGENT_MIN_CHARS_PAGE=10

# --- Heading / layout heuristics ---
PDF_AGENT_HEADING_DELTA=1.5
PDF_AGENT_HEADER_ZONE=0.08
PDF_AGENT_FOOTER_ZONE=0.08

# --- Logging ---
PDF_AGENT_LOG_LEVEL=INFO
PDF_AGENT_LOG_CONSOLE=true
PDF_AGENT_LOG_ROTATION=10 MB
PDF_AGENT_LOG_RETENTION=10 days

# --- Database ---
PDF_AGENT_JOURNAL_MODE=WAL
PDF_AGENT_SYNCHRONOUS=NORMAL
